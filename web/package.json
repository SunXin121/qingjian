{
  "name": "qingjian-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-assets": "rm -rf public/excalidraw-assets && mkdir -p public/excalidraw-assets && cp -r node_modules/@excalidraw/excalidraw/dist/prod/fonts public/excalidraw-assets/",
    "build": "npm run copy-assets && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@viz-js/viz": "^3.31.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "lodash": "4.18.1",
    "lucide-react": "^0.468.0",
    "marked": "16.4.2",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-responsive-carousel": "3.2.23",
    "react-router": "^7.18.5",
    "simple-mind-map": "^0.14.0-fix.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
