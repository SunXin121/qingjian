# 管理密码，务必改成足够长的随机字符串
QINGJIAN_ADMIN_PASSWORD=change-me-to-a-long-random-password

# 端口映射：默认只监听本机 127.0.0.1:8080，交给反向代理转发。
# 如果要直接对外访问，把 QINGJIAN_BIND 改成 0.0.0.0（强烈建议配合 HTTPS 反向代理使用）
QINGJIAN_BIND=127.0.0.1
QINGJIAN_PORT=8080

# 放在反向代理后面时设为 1（用于识别真实 IP 与 HTTPS）
QINGJIAN_TRUST_PROXY=1

# 单个附件大小上限（MB）
QINGJIAN_MAX_UPLOAD_MB=100

# 使用的镜像（默认 GitHub Container Registry，也可以换成 Docker Hub 上的镜像）
# QINGJIAN_IMAGE=ghcr.io/sunxin121/qingjian:latest

# 回收站保留天数
# QINGJIAN_TRASH_DAYS=30

# draw.io 编辑器地址（默认官方嵌入版）；或用 QINGJIAN_DRAWIO_DIR 指向本地解压的 draw.war
# QINGJIAN_DRAWIO_URL=https://embed.diagrams.net/

# ---- 自动备份（配置任意一个目标即开启）----
# QINGJIAN_BACKUP_INTERVAL_HOURS=24
# QINGJIAN_BACKUP_KEEP=7
# 本地目录（容器内路径，需要在 docker-compose.yml 里挂载）
# QINGJIAN_BACKUP_DIR=/backup
# WebDAV（如坚果云：https://dav.jianguoyun.com/dav/qingjian/ ，密码填“应用密码”）
# QINGJIAN_BACKUP_WEBDAV_URL=
# QINGJIAN_BACKUP_WEBDAV_USER=
# QINGJIAN_BACKUP_WEBDAV_PASSWORD=
# S3 / MinIO / R2
# QINGJIAN_BACKUP_S3_ENDPOINT=
# QINGJIAN_BACKUP_S3_REGION=us-east-1
# QINGJIAN_BACKUP_S3_BUCKET=
# QINGJIAN_BACKUP_S3_PREFIX=qingjian/
# QINGJIAN_BACKUP_S3_ACCESS_KEY=
# QINGJIAN_BACKUP_S3_SECRET_KEY=
